# Never commit a populated .env file. The desktop app reads only process
# environment variables; scripts optionally load this development file.
GEMINI_API_KEY=your_gemini_api_key
# Optional comma-separated development fallback keys. Used only after temporary
# 429/5xx availability failures; never for authentication or validation errors.
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-2.5-flash

# DataHub Core / OSS. GMS is used by the official MCP Server. GraphQL remains
# available to deterministic seed/verification tooling, but the judge-facing
# Cursivis grounding flow reads catalog context through MCP tools.
DATAHUB_GMS_URL=http://localhost:8080
DATAHUB_GRAPHQL_URL=http://localhost:8080/api/graphql
DATAHUB_TOKEN=
# For authenticated MCP deployments DATAHUB_GMS_TOKEN takes precedence.
DATAHUB_GMS_TOKEN=
# run-demo.ps1 sets these automatically after bootstrap; override only when
# using another trusted official DataHub MCP launcher/version.
DATAHUB_MCP_COMMAND=
# Pinned to the current verified official release used by this submission.
# Avoid @latest in the golden path so a future upstream release cannot silently
# change tool schemas between judging runs.
DATAHUB_MCP_PACKAGE=mcp-server-datahub@0.6.0
CURSIVIS_RUN_LIVE_TESTS=0
