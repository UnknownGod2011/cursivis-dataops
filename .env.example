# Never commit a populated .env file. The desktop app reads only process
# environment variables; scripts optionally load this development file.
GEMINI_API_KEY=your_gemini_api_key
# Optional comma-separated development fallback keys. Used only after temporary
# 429/5xx availability failures; never for authentication or validation errors.
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-2.5-flash
DATAHUB_GRAPHQL_URL=http://localhost:9002/api/graphql
DATAHUB_TOKEN=
CURSIVIS_RUN_LIVE_TESTS=0
