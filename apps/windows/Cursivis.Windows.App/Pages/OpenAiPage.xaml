<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Cursivis.Windows.App.Pages.OpenAiPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Cursivis.Windows.App.Controls">

    <Grid x:Name="PageRoot" Padding="{StaticResource PagePadding}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PageRoot.Padding" Value="{StaticResource PagePaddingNarrow}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="760" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PageRoot.Padding" Value="{StaticResource PagePadding}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <ScrollViewer HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="920" HorizontalAlignment="Stretch" Spacing="20">
                <StackPanel Spacing="4">
                    <TextBlock
                        Text="AI &amp; DataHub"
                        FontSize="28"
                        FontWeight="SemiBold" />
                    <TextBlock
                        Text="Gemini reasons over live DataHub schema, ownership, descriptions, and lineage."
                        Style="{StaticResource CaptionSecondaryTextStyle}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <controls:SettingsCard IconGlyph="&#xE8D7;">
                    <controls:SettingsCard.Body>
                        <StackPanel Spacing="10">
                            <TextBlock Text="Gemini API key" FontWeight="SemiBold" />
                            <TextBlock
                                Text="Stored with Windows current-user protection. GEMINI_API_KEY from the launching process takes precedence for development."
                                Style="{StaticResource CaptionSecondaryTextStyle}"
                                TextWrapping="Wrap" />
                            <controls:SecureKeyInput
                                x:Name="GeminiKeyInput"
                                AutomationProperties.AutomationId="GeminiSecureKeyInput"
                                HasSavedKey="False"
                                IsSecureStorageAvailable="False"
                                SaveRequested="OnSaveRequested"
                                DeleteRequested="OnDeleteRequested"
                                TestRequested="OnTestRequested" />
                            <HyperlinkButton
                                AutomationProperties.AutomationId="GeminiGetApiKeyLink"
                                HorizontalAlignment="Left"
                                Content="Get a Gemini API key"
                                NavigateUri="https://aistudio.google.com/app/apikey" />
                        </StackPanel>
                    </controls:SettingsCard.Body>
                </controls:SettingsCard>

                <controls:SettingsCard IconGlyph="&#xE950;">
                    <controls:SettingsCard.Body>
                        <StackPanel Spacing="10">
                            <TextBlock Text="Gemini model" FontWeight="SemiBold" />
                            <TextBox
                                x:Name="GeminiModelInput"
                                AutomationProperties.AutomationId="GeminiModel"
                                Header="Model ID"
                                PlaceholderText="gemini-2.5-flash" />
                            <TextBlock
                                Text="The hackathon flow uses Gemini structured output. Keep this on a model that supports JSON-schema structured responses."
                                Style="{StaticResource CaptionSecondaryTextStyle}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </controls:SettingsCard.Body>
                </controls:SettingsCard>

                <controls:SettingsCard IconGlyph="&#xE774;">
                    <controls:SettingsCard.Body>
                        <StackPanel Spacing="10">
                            <TextBlock Text="DataHub" FontWeight="SemiBold" />
                            <TextBox
                                x:Name="DataHubEndpointInput"
                                AutomationProperties.AutomationId="DataHubGraphQlEndpoint"
                                Header="GraphQL endpoint"
                                PlaceholderText="http://localhost:8080/api/graphql" />
                            <TextBlock
                                Text="Local DataHub quickstart works without a token. For authenticated instances, set DATAHUB_TOKEN in the launching environment. Model and endpoint edits below apply to the current app session; environment variables remain the reproducible launch configuration."
                                Style="{StaticResource CaptionSecondaryTextStyle}"
                                TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    AutomationProperties.AutomationId="ApplyDataOpsConfiguration"
                                    Content="Apply connection settings"
                                    Click="OnSaveConnectionSettingsClicked" />
                                <Button
                                    AutomationProperties.AutomationId="TestDataHubConnection"
                                    Content="Test DataHub"
                                    Click="OnTestDataHubClicked" />
                            </StackPanel>
                        </StackPanel>
                    </controls:SettingsCard.Body>
                </controls:SettingsCard>

                <InfoBar
                    x:Name="ConnectionInfo"
                    IsClosable="False"
                    IsOpen="True"
                    Severity="Informational"
                    Title="Gemini + DataHub"
                    Message="Configure Gemini, then start DataHub and seed the demo catalog before running the grounded SQL workflow." />

                <TextBlock
                    Text="Optional inherited voice/realtime features are separate from this hackathon flow and are not required for Gemini + DataHub grounding."
                    Style="{StaticResource CaptionSecondaryTextStyle}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
